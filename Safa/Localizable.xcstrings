    "Start your evening dhikr and prepare for a restful night.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابدأ أذكار المساء واستعد لليلة هادئة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সন্ধ্যার যিকির শুরু করুন এবং একটি শান্তিপূর্ণ রাতের জন্য প্রস্তুত হন।"
          }
