            "state": "translated",
            "value": "Aturkan Korban untuk 10-12 Zulhijjah"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "10-12 Zilhicce için Kurban hazırlayın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "١٠-١٢ ذوالحجہ کے لیے قربانی کا بندوبست کریں"
          }
        }
      }
    },
