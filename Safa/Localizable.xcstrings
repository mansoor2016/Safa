    "Adhan won't play when your iPhone is on silent mode.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يُشغَّل الأذان عندما يكون هاتفك في الوضع الصامت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার আইফোন সাইলেন্ট মোডে থাকলে আযান বাজবে না।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وقتی آیفون شما در حالت سکوت است، اذان پخش نمی‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adhan ne sera pas joué lorsque votre iPhone est en mode silencieux."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Adzan tidak akan berbunyi saat iPhone dalam mode senyap."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Azan tidak akan berbunyi apabila iPhone anda dalam mod senyap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'unuz sessiz moddayken ezan çalmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جب آپ کا آئی فون خاموش موڈ پر ہو تو اذان نہیں بجے گی۔"
          }
        }
      }
    },
