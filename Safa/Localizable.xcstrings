    "Apple Health access was denied. Please enable access in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول إلى Apple Health. يرجى تفعيل الوصول في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health অ্যাক্সেস অস্বীকার করা হয়েছে। সেটিংসে অ্যাক্সেস সক্ষম করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به سلامت اپل رد شد. لطفاً در تنظیمات، دسترسی را فعال کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès à Apple Santé a été refusé. Veuillez activer l'accès dans les Réglages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Apple Health ditolak. Harap aktifkan akses di Pengaturan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses Apple Health dinafikan. Sila aktifkan akses dalam Tetapan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Sağlık erişimi reddedildi. Lütfen Ayarlar'dan erişimi etkinleştirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health تک رسائی مسترد کر دی گئی۔ برائے مہربانی ترتیبات میں رسائی فعال کریں۔"
          }
        }
      }
    },
    "Apple Health is not available on this device.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health غير متاح على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে Apple Health উপলব্ধ নেই।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سلامت اپل در این دستگاه در دسترس نیست."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Santé n'est pas disponible sur cet appareil."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health tidak tersedia di perangkat ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Health tidak tersedia pada peranti ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Sağlık bu cihazda mevcut değil."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ڈیوائس پر Apple Health دستیاب نہیں ہے۔"
          }
        }
      }
    },
