    "Pay before Eid prayer — approx. £5-7/person": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادفع قبل صلاة العيد — تقريبًا ٥-٧ جنيهات/شخص"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঈদের নামাজের আগে পরিশোধ করুন — প্রায় £৫-৭/জন"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل از نماز عید پرداخت کنید — تقریباً ۵-۷ پوند/نفر"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Payez avant la prière de l'Aïd — env. 5-7 £/personne"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayar sebelum salat Ied — sekitar £5-7/orang"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayar sebelum solat Hari Raya — lebih kurang £5-7/orang"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayram namazından önce ödeyin — yakl. 5-7 £/kişi"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عید کی نماز سے پہلے ادا کریں — تقریباً £5-7/فرد"
          }
        }
      }
    },
    "Arrange Qurbani for 10th-12th Dhul Hijjah": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رتب الأضحية من ١٠ إلى ١٢ ذو الحجة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "১০-১২ জিলহজ্জের জন্য কুরবানির ব্যবস্থা করুন"
          }
