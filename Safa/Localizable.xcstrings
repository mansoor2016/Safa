    "Please read these terms carefully before using Safa.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرجى قراءة هذه الشروط بعناية قبل استخدام Safa."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Safa ব্যবহার করার আগে দয়া করে এই শর্তাবলী সাবধানে পড়ুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لطفاً این شرایط را قبل از استفاده از Safa با دقت بخوانید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Veuillez lire attentivement ces conditions avant d'utiliser Safa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harap baca ketentuan ini dengan saksama sebelum menggunakan Safa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sila baca terma ini dengan teliti sebelum menggunakan Safa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safa'yı kullanmadan önce lütfen bu şartları dikkatlice okuyun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Safa استعمال کرنے سے پہلے براہ کرم یہ شرائط احتیاط سے پڑھیں۔"
          }
        }
      }
    },
