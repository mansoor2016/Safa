          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "شما %1$lld بار%2$@ به اشتراک گذاشته‌اید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez partagé %1$lld fois%2$@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah membagikan %1$lld kali%2$@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda telah berkongsi %1$lld kali%2$@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld kez%2$@ paylaştınız"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ نے %1$lld بار%2$@ شیئر کیا"
          }
        }
      }
    },
    "Your answer...": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إجابتك..."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার উত্তর..."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ شما..."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre réponse..."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawaban Anda..."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jawapan anda..."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevabınız..."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا جواب..."
          }
        }
      }
    },
    "Your data is exported as a file you can save or share. JSON includes all data; CSV is a spreadsheet of prayer logs.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تصدير بياناتك كملف يمكنك حفظه أو مشاركته. JSON يتضمن جميع البيانات؛ CSV هو جدول بيانات سجلات الصلاة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ডেটা একটি ফাইল হিসাবে রপ্তানি করা হয় যা আপনি সংরক্ষণ বা শেয়ার করতে পারেন। JSON সমস্ত ডেটা অন্তর্ভুক্ত করে; CSV হল নামাজ লগের একটি স্প্রেডশীট।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های شما به عنوان فایلی صادر می‌شوند که می‌توانید ذخیره یا به اشتراک بگذارید. JSON شامل همه داده‌ها است؛ CSV یک صفحه گسترده از ثبت نماز است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont exportées sous forme de fichier que vous pouvez enregistrer ou partager. JSON inclut toutes les données ; CSV est une feuille de calcul des prières enregistrées."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Anda diekspor sebagai file yang dapat Anda simpan atau bagikan. JSON mencakup semua data; CSV adalah spreadsheet catatan shalat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data anda dieksport sebagai fail yang boleh anda simpan atau kongsi. JSON termasuk semua data; CSV ialah hamparan rekod solat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz kaydedebileceğiniz veya paylaşabileceğiniz bir dosya olarak dışa aktarılır. JSON tüm verileri içerir; CSV namaz kayıtlarının bir tablosudur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ڈیٹا ایک فائل کے طور پر برآمد ہوتا ہے جسے آپ محفوظ یا شیئر کر سکتے ہیں۔ JSON میں تمام ڈیٹا شامل ہے؛ CSV نماز کے لاگز کی اسپریڈ شیٹ ہے۔"
          }
        }
      }
    },
    "Your data is stored locally on your device. Safa does not collect or share personal data.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بياناتك مخزنة محليًا على جهازك. Safa لا يجمع أو يشارك البيانات الشخصية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ডেটা আপনার ডিভাইসে স্থানীয়ভাবে সংরক্ষিত। Safa ব্যক্তিগত ডেটা সংগ্রহ বা শেয়ার করে না।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های شما به صورت محلی در دستگاه شما ذخیره می‌شوند. Safa داده‌های شخصی را جمع‌آوری یا به اشتراک نمی‌گذارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données sont stockées localement sur votre appareil. Safa ne collecte ni ne partage de données personnelles."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data Anda disimpan secara lokal di perangkat Anda. Safa tidak mengumpulkan atau membagikan data pribadi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data anda disimpan secara tempatan pada peranti anda. Safa tidak mengumpul atau berkongsi data peribadi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verileriniz cihazınızda yerel olarak saklanır. Safa kişisel veri toplamaz veya paylaşmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا ڈیٹا آپ کے ڈیوائس پر مقامی طور پر محفوظ ہے۔ Safa ذاتی ڈیٹا جمع یا شیئر نہیں کرتا۔"
          }
        }
      }
    },
    "Your Islamic Companion": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفيقك الإسلامي"
