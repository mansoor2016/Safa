      }
    },
    "Allah has ninety-nine Names, one-hundred less one; and he who memorizes them all by heart will enter Paradise.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إن لله تسعة وتسعين اسمًا، مائة إلا واحدًا، من أحصاها دخل الجنة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আল্লাহর নিরানব্বইটি নাম রয়েছে, একশো থেকে একটি কম; এবং যে তাদের সকলকে হৃদয় দিয়ে মুখস্থ করবে সে জান্নাতে প্রবেশ করবে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "الله نود و نه نام دارد، یکی کمتر از صد؛ و هر کس همه آن‌ها را حفظ کند، به بهشت می‌رود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allah a quatre-vingt-dix-neuf Noms, cent moins un ; et celui qui les mémorise tous par cœur entrera au Paradis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Allah memiliki sembilan puluh sembilan Nama, seratus kurang satu; dan barang siapa menghafalnya semuanya akan masuk Surga."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Allah mempunyai sembilan puluh sembilan Nama, seratus tolak satu; dan sesiapa yang menghafalnya akan masuk Syurga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allah'ın doksan dokuz ismi vardır, yüzden bir eksik; ve bunların hepsini ezberleyen Cennet'e girer."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اللہ کے ننانوے نام ہیں، سو میں سے ایک کم؛ اور جو انہیں دل سے یاد کرے گا وہ جنت میں داخل ہوگا۔"
          }
        }
      }
    },
