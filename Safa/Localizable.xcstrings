    },
    "Enable Smart Cleanup to automatically remove audio files you haven't listened to in a while.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل التنظيف الذكي لإزالة الملفات الصوتية التي لم تستمع إليها منذ فترة تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কিছুক্ষণ শোনেননি এমন অডিও ফাইলগুলি স্বয়ংক্রিয়ভাবে সরাতে স্মার্ট ক্লিনআপ সক্ষম করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاک‌سازی هوشمند را فعال کنید تا فایل‌های صوتی که مدتی به آن‌ها گوش نداده‌اید، به طور خودکار حذف شوند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le nettoyage intelligent pour supprimer automatiquement les fichiers audio que vous n'avez pas écoutés depuis un moment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Pembersihan Cerdas untuk otomatis menghapus file audio yang sudah lama tidak didengarkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan Pembersihan Pintar untuk membuang fail audio yang tidak anda dengar untuk seketika secara automatik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir süredir dinlemediğiniz ses dosyalarını otomatik olarak kaldırmak için Akıllı Temizlik'i etkinleştirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خودکار طور پر آڈیو فائلیں ہٹانے کے لیے Smart Cleanup فعال کریں جنہیں آپ نے کچھ عرصے سے نہیں سنا۔"
          }
        }
      }
    },
