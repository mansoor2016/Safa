    "Bismillah! Time to break your fast.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بسم الله! حان وقت الإفطار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিসমিল্লাহ! আপনার রোজা ভাঙার সময়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بسم الله! وقت افطار است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bismillah ! Il est temps de rompre le jeûne."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bismillah! Waktunya berbuka puasa."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bismillah! Masa berbuka puasa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bismillah! Orucunu açma vakti."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بسم اللہ! روزہ افطار کا وقت ہے۔"
          }
        }
      }
    },
    "Bismillah. May Safa be a means of benefit for you in this life and the next.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بسم الله. نسأل الله أن يجعل Safa وسيلة نفع لك في الدنيا والآخرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিসমিল্লাহ। Safa আপনার জন্য এই জীবন এবং পরকালে উপকারের একটি মাধ্যম হোক।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بسم الله. Safa وسیله‌ای برای سود شما در این دنیا و آخرت باشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bismillah. Que Safa soit un moyen de bénéfice pour vous dans cette vie et dans l'au-delà."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bismillah. Semoga Safa menjadi manfaat bagimu di dunia dan akhirat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bismillah. Semoga Safa menjadi wasilah kebaikan untuk anda di dunia dan akhirat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bismillah. Safa bu dünyada ve ahirette senin için fayda vesilesi olsun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بسم اللہ۔ Safa آپ کے لیے اس دنیا اور آخرت میں فائدے کا ذریعہ بنے۔"
          }
        }
      }
    },
