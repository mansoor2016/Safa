    "Get a reminder to prepare for prayer before each prayer time.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على تذكير للاستعداد للصلاة قبل كل وقت صلاة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি নামাজের সময়ের আগে নামাজের জন্য প্রস্তুতির অনুস্মারক পান।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک یادآوری برای آماده شدن برای نماز قبل از هر وقت نماز دریافت کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez un rappel pour préparer la prière avant chaque horaire de prière."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan pengingat untuk bersiap shalat sebelum setiap waktu shalat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan peringatan untuk bersiap solat sebelum setiap waktu solat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her namaz vaktinden önce namaza hazırlanmak için hatırlatıcı al."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر نماز کے وقت سے پہلے نماز کے لیے تیاری کی یاد دہانی حاصل کریں۔"
          }
        }
      }
    },
