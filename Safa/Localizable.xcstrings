    "Don't forget your Taraweeh prayers tonight. May your worship be accepted.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تنسَ صلاة التراويح الليلة. تقبل الله منك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজ রাতে আপনার তারাবীহ নামাজ ভুলে যাবেন না। আপনার ইবাদত কবুল হোক।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز تراویح امشب را فراموش نکنید. عبادت شما پذیرفته شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'oubliez pas vos prières de Tarawih ce soir. Que votre adoration soit acceptée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan lupa shalat Tarawih malam ini. Semoga ibadahmu diterima."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan lupa solat Terawih malam ini. Semoga ibadah anda diterima."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu gece Teravih namazlarını unutma. İbadetlerin kabul olsun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آج رات اپنی تراویح کی نمازیں نہ بھولیں۔ آپ کی عبادت قبول ہو۔"
          }
        }
      }
    },
