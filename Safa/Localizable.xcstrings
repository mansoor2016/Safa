    "Wi-Fi only prevents large downloads from using cellular data. Auto-update keeps your content current when connected to Wi-Fi.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi فقط يمنع التنزيلات الكبيرة من استخدام بيانات الجوّال. التحديث التلقائي يحافظ على محتواك محدثًا عند الاتصال بـ Wi-Fi."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi শুধুমাত্র বড় ডাউনলোডগুলিকে সেলুলার ডেটা ব্যবহার করা থেকে বাধা দেয়। Wi-Fi এর সাথে সংযুক্ত থাকলে স্বয়ংক্রিয়-আপডেট আপনার বিষয়বস্তু বর্তমান রাখে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط Wi-Fi از استفاده داده‌های سلولی برای دانلودهای بزرگ جلوگیری می‌کند. به‌روزرسانی خودکار محتوای شما را وقتی به Wi-Fi متصل هستید، به‌روز نگه می‌دارد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Wi-Fi uniquement empêche les gros téléchargements d'utiliser les données cellulaires. La mise à jour automatique maintient votre contenu à jour lorsque vous êtes connecté au Wi-Fi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi saja mencegah unduhan besar menggunakan data seluler. Pembaruan otomatis menjaga konten Anda tetap terkini saat terhubung ke Wi-Fi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi sahaja menghalang muat turun besar daripada menggunakan data selular. Kemas kini automatik memastikan kandungan anda terkini apabila disambung ke Wi-Fi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Wi-Fi, büyük indirmelerin hücresel veri kullanmasını engeller. Otomatik güncelleme, Wi-Fi'ye bağlıyken içeriğinizi güncel tutar."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi صرف بڑے ڈاؤن لوڈز کو سیلولر ڈیٹا استعمال کرنے سے روکتا ہے۔ خودکار اپ ڈیٹ Wi-Fi سے منسلک ہونے پر آپ کے مواد کو تازہ رکھتا ہے۔"
          }
        }
      }
    },
    "WiFi connection required for downloads": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُطلب اتصال Wi-Fi للتنزيلات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ডাউনলোডের জন্য WiFi সংযোগ প্রয়োজন"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال WiFi برای دانلود لازم است"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion Wi-Fi requise pour les téléchargements"
          }
        },
        "id": {
