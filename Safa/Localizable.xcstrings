    "Next prayer is %@ at %@, %lld hours and %lld minutes remaining": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ الصلاة التالية هي في %2$@، متبقي %3$lld ساعة و%4$lld دقيقة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ পরবর্তী নামাজ সময় %2$@, %3$lld ঘণ্টা এবং %4$lld মিনিট বাকি"
