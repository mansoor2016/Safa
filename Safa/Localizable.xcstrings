    "Accessibility features are not yet fully functional. Safa will support Dynamic Type, VoiceOver, and other iOS accessibility features in a future update.": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ميزات إمكانية الوصول غير مفعّلة بالكامل بعد. سيدعم Safa الخط الديناميكي وVoiceOver وميزات إمكانية الوصول الأخرى في تحديث قادم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাক্সেসযোগ্যতা বৈশিষ্ট্যগুলি এখনও সম্পূর্ণভাবে কার্যকর নয়। Safa ভবিষ্যতের আপডেটে ডায়নামিক টাইপ, ভয়েসওভার এবং অন্যান্য iOS অ্যাক্সেসযোগ্যতা বৈশিষ্ট্য সমর্থন করবে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ویژگی‌های دسترسی‌پذیری هنوز کاملاً کاربردی نیستند. Safa در آینده از نوع پویا، VoiceOver و سایر ویژگی‌های دسترسی‌پذیری iOS پشتیبانی خواهد کرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fonctionnalités d'accessibilité ne sont pas encore complètement fonctionnelles. Safa prendra en charge Dynamic Type, VoiceOver et d'autres fonctionnalités d'accessibilité iOS dans une prochaine mise à jour."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitur aksesibilitas belum sepenuhnya berfungsi. Safa akan mendukung Tipe Dinamis, VoiceOver, dan fitur aksesibilitas iOS lainnya dalam pembaruan mendatang."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciri kebolehcapaian belum berfungsi sepenuhnya. Safa akan menyokong Dynamic Type, VoiceOver, dan ciri kebolehcapaian iOS lain dalam kemas kini akan datang."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişilebilirlik özellikleri henüz tam olarak işlevsel değil. Safa gelecekteki bir güncellemede Dinamik Yazı Tipi, VoiceOver ve diğer iOS erişilebilirlik özelliklerini destekleyecek."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رسائی کی خصوصیات ابھی مکمل طور پر فعال نہیں ہیں۔ Safa مستقبل کی اپڈیٹ میں Dynamic Type، VoiceOver اور دیگر iOS رسائی خصوصیات کی حمایت کرے گا۔"
          }
        }
      }
    },
