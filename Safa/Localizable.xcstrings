    "Tap the heart on any dua to save it here.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على القلب في أي دعاء لحفظه هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখানে সংরক্ষণ করতে যেকোন দোয়ার হার্টে ট্যাপ করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی قلب در هر دعا ضربه بزنید تا اینجا ذخیره شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur le cœur de n'importe quelle dou'a pour l'enregistrer ici."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk hati pada doa mana pun untuk menyimpannya di sini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk hati pada sebarang doa untuk simpan di sini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir duayı buraya kaydetmek için kalbe dokunun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کسی بھی دعا پر دل ٹیپ کریں تاکہ اسے یہاں محفوظ کریں۔"
          }
        }
      }
    },
