    "No ads. No clutter. No tracking.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا إعلانات. لا تشويش. لا تتبع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোন বিজ্ঞাপন নেই। কোন অগোছালো নেই। কোন ট্র্যাকিং নেই।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون تبلیغ. بدون آشفتگی. بدون ردیابی."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de publicités. Pas de désordre. Pas de suivi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa iklan. Tanpa kekacauan. Tanpa pelacakan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada iklan. Tiada kekacauan. Tiada penjejakan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reklam yok. Karışıklık yok. Takip yok."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی اشتہارات نہیں۔ کوئی بے ترتیبی نہیں۔ کوئی ٹریکنگ نہیں۔"
          }
        }
      }
    },
    "No ayahs found for \"%@\".\nTry a different search term.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على آيات لـ \"%@\".\nجرّب مصطلح بحث آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" এর জন্য কোন আয়াত পাওয়া যায়নি।\nএকটি ভিন্ন অনুসন্ধান শব্দ চেষ্টা করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هیچ آیه‌ای برای «%@» یافت نشد.\nیک عبارت جستجوی دیگر امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun verset trouvé pour « %@ ».\nEssayez un autre terme de recherche."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada ayat ditemukan untuk \"%@\".\nCoba istilah pencarian lain."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada ayat dijumpai untuk \"%@\".\nCuba istilah carian lain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" için ayet bulunamadı.\nFarklı bir arama terimi deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" کے لیے کوئی آیات نہیں ملیں۔\nدوسرا تلاش کا لفظ آزمائیں۔"
          }
        }
      }
    },
