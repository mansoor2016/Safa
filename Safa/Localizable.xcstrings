    "Your location is used to calculate accurate prayer times.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم موقعك لحساب أوقات الصلاة الدقيقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার অবস্থান সঠিক নামাজের সময় গণনা করতে ব্যবহৃত হয়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "موقعیت شما برای محاسبه اوقات نماز دقیق استفاده می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre emplacement est utilisé pour calculer des horaires de prière précis."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi Anda digunakan untuk menghitung waktu shalat yang akurat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokasi anda digunakan untuk mengira waktu solat yang tepat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konumunuz doğru namaz vakitlerini hesaplamak için kullanılır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا مقام درست نماز کے اوقات کا حساب لگانے کے لیے استعمال ہوتا ہے۔"
          }
        }
      }
    },
