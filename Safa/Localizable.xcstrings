    "By using Safa, you agree to these terms. If you disagree, please do not use the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "باستخدامك Safa، فإنك توافق على هذه الشروط. إذا كنت لا توافق، يرجى عدم استخدام التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Safa ব্যবহার করে, আপনি এই শর্তাবলীতে সম্মত হন। যদি আপনি অসম্মত হন, তবে অ্যাপটি ব্যবহার করবেন না।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با استفاده از Safa، با این شرایط موافقت می‌کنید. اگر موافق نیستید، لطفاً از برنامه استفاده نکنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En utilisant Safa, vous acceptez ces conditions. Si vous n'êtes pas d'accord, veuillez ne pas utiliser l'application."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan menggunakan Safa, Anda menyetujui ketentuan ini. Jika tidak setuju, harap jangan gunakan aplikasi ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan menggunakan Safa, anda bersetuju dengan terma ini. Jika tidak bersetuju, sila jangan gunakan aplikasi ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safa'yı kullanarak bu şartları kabul etmiş olursunuz. Kabul etmiyorsanız, lütfen uygulamayı kullanmayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Safa استعمال کر کے، آپ ان شرائط سے متفق ہیں۔ اگر آپ متفق نہیں ہیں تو براہ کرم ایپ استعمال نہ کریں۔"
          }
        }
      }
    },
