    "%@ prayer is already logged for today.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صلاة %@ مسجلة بالفعل لليوم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আজকের জন্য %@ নামাজ ইতিমধ্যে লগ করা হয়েছে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز %@ برای امروز ثبت شده است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La prière %@ est déjà enregistrée pour aujourd'hui."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Shalat %@ sudah dicatat untuk hari ini."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Solat %@ sudah direkod untuk hari ini."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ namazı bugün için zaten kaydedildi."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ نماز آج پہلے سے لاگ ہے۔"
          }
        }
      }
    },
