    "To change the app language, go to your device Settings → Safa → Language": {
      "extractionState": "stale",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتغيير لغة التطبيق، انتقل إلى إعدادات الجهاز ← Safa ← اللغة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাপ ভাষা পরিবর্তন করতে, আপনার ডিভাইস সেটিংস → Safa → ভাষা এ যান"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تغییر زبان برنامه، به تنظیمات دستگاه → Safa → زبان بروید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour changer la langue de l'application, allez dans les Réglages de votre appareil → Safa → Langue"
          }
        },
