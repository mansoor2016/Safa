            "value": "Cette semaine"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu Ini"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Minggu Ini"
          }
        },
        "tr": {
          "stringUnit": {
