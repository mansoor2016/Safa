    "Your wealth is below the Nisab threshold. Zakat is not obligatory, but voluntary charity (Sadaqah) is always encouraged.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مالك أقل من نصاب الزكاة. الزكاة غير واجبة، لكن الصدقة التطوعية دائمًا مستحبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সম্পদ নিসাব সীমার নীচে। যাকাত বাধ্যতামূলক নয়, তবে স্বেচ্ছায় দাতব্য (সাদাকাহ) সর্বদা উৎসাহিত করা হয়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ثروت شما کمتر از آستانه نصاب است. زکات واجب نیست، اما صدقه داوطلبانه همیشه تشویق می‌شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre richesse est en-dessous du seuil Nisab. La Zakat n'est pas obligatoire, mais la charité volontaire (Sadaqa) est toujours encouragée."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harta Anda di bawah ambang Nisab. Zakat tidak wajib, tetapi sedekah sukarela (Sedekah) selalu dianjurkan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekayaan anda di bawah nisab. Zakat tidak wajib, tetapi sedekah sukarela sentiasa digalakkan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servetiniz Nisap eşiğinin altında. Zekat farz değildir, ancak gönüllü sadaka her zaman teşvik edilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی دولت نصاب کی حد سے نیچے ہے۔ زکوٰۃ واجب نہیں ہے، لیکن رضاکارانہ صدقہ (صدقہ) ہمیشہ حوصلہ افزائی کی جاتی ہے۔"
          }
        }
      }
    },
    "Zakat Calculator": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاسبة الزكاة"
          }
        },
        "bn": {
          "stringUnit": {
