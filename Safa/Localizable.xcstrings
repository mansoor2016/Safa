    "Make sure silent mode is off so the adhan plays aloud.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من إيقاف الوضع الصامت حتى يُشغَّل الأذان بصوت عالٍ."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিশ্চিত করুন যে সাইলেন্ট মোড বন্ধ আছে যাতে আযান উচ্চস্বরে বাজে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مطمئن شوید حالت سکوت خاموش است تا اذان با صدای بلند پخش شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Assurez-vous que le mode silencieux est désactivé pour que l'adhan soit joué à voix haute."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan mode senyap dimatikan agar adzan berbunyi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan mod senyap dimatikan supaya azan berbunyi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezanın sesli çalması için sessiz modun kapalı olduğundan emin olun."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یقینی بنائیں کہ خاموش موڈ بند ہے تاکہ اذان بلند آواز میں بجے۔"
          }
        }
      }
    },
