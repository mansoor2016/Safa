    "• Three-finger swipe to navigate between pages": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• اسحب بثلاثة أصابع للتنقل بين الصفحات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "• পৃষ্ঠাগুলির মধ্যে নেভিগেট করতে তিন আঙুলে সোয়াইপ করুন"
          }
        },
        "fa": {
          "stringUnit": {
