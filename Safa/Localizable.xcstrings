        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বার্তা খুব দীর্ঘ। এটি সংক্ষিপ্ত করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
