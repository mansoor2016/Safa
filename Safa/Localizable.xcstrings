    "Triple-tap the version number to hide.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر ثلاث مرات على رقم الإصدار للإخفاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লুকাতে সংস্করণ নম্বরে ট্রিপল-ট্যাপ করুন।"
          }
