    "Calendar access was denied. Please enable access in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض الوصول إلى التقويم. يرجى تفعيل الوصول في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডার অ্যাক্সেস অস্বীকার করা হয়েছে। সেটিংসে অ্যাক্সেস সক্ষম করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دسترسی به تقویم رد شد. لطفاً در تنظیمات، دسترسی را فعال کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au calendrier a été refusé. Veuillez activer l'accès dans les Réglages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalender ditolak. Harap aktifkan akses di Pengaturan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses kalendar dinafikan. Sila aktifkan akses dalam Tetapan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim erişimi reddedildi. Lütfen Ayarlar'dan erişimi etkinleştirin."
