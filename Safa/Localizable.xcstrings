    "Subscribers get custom app icons and early access to new features.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحصل المشتركون على أيقونات مخصصة للتطبيق ووصول مبكر للميزات الجديدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবস্ক্রাইবাররা কাস্টম অ্যাপ আইকন এবং নতুন ফিচারে আগাম অ্যাক্সেস পান।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مشترکین آیکون‌های سفارشی و دسترسی زودهنگام به ویژگی‌های جدید دریافت می‌کنند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les abonnés bénéficient d'icônes personnalisées et d'un accès anticipé aux nouvelles fonctionnalités."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelanggan mendapatkan ikon aplikasi kustom dan akses awal ke fitur baru."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelanggan mendapat ikon aplikasi tersuai dan akses awal ke ciri baharu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aboneler özel uygulama simgeleri ve yeni özelliklere erken erişim elde eder."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سبسکرائبرز کو کسٹم ایپ آئیکنز اور نئی خصوصیات تک جلد رسائی ملتی ہے۔"
          }
        }
      }
    },
