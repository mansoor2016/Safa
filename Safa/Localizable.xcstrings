    "vs last week": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقارنة بالأسبوع الماضي"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গত সপ্তাহের তুলনায়"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در مقایسه با هفته گذشته"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "par rapport à la semaine dernière"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "dibanding minggu lalu"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "berbanding minggu lepas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "geçen haftaya göre"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلے ہفتے کے مقابلے"
          }
        }
      }
    },
    "Wake up for Fajr prayer. May Allah accept your worship.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيقظ لصلاة الفجر. تقبل الله عبادتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফজর নামাজের জন্য জেগে উঠুন। আল্লাহ আপনার ইবাদত কবুল করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای نماز فجر بیدار شوید. الله عبادت شما را بپذیرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réveillez-vous pour la prière Fajr. Qu'Allah accepte votre adoration."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun untuk shalat Subuh. Semoga Allah menerima ibadahmu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bangun untuk solat Subuh. Semoga Allah menerima ibadah anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabah namazı için uyan. Allah ibadetini kabul etsin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فجر کی نماز کے لیے بیدار ہوں۔ اللہ آپ کی عبادت قبول فرمائے۔"
          }
        }
      }
    },
    "We do not sell, trade, or share your personal information with anyone. Period.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نحن لا نبيع أو نتاجر أو نشارك معلوماتك الشخصية مع أي أحد. نقطة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা আপনার ব্যক্তিগত তথ্য কারো সাথে বিক্রয়, বিনিময় বা শেয়ার করি না। সম্পূর্ণভাবে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ما اطلاعات شخصی شما را به هیچ کس نمی‌فروشیم، معامله نمی‌کنیم یا به اشتراک نمی‌گذاریم. نقطه."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous ne vendons, n'échangeons ni ne partageons vos informations personnelles avec quiconque. Point final."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak menjual, menukar, atau membagikan informasi pribadi Anda kepada siapa pun. Titik."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami tidak menjual, berdagang, atau berkongsi maklumat peribadi anda dengan sesiapa. Titik."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel bilgilerinizi kimseyle satmaz, takas etmez veya paylaşmayız. Nokta."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم آپ کی ذاتی معلومات کسی کو فروخت، تجارت یا شیئر نہیں کرتے۔ بالکل نہیں۔"
          }
        }
      }
    },
    "Well Done!": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحسنت!"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাবাশ!"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آفرین!"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bien joué !"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagus!"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Syabas!"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aferin!"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بہت خوب!"
          }
        }
      }
    },
    "What happened?\nWhich page were you on?\nWhat did you expect instead?": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ماذا حدث؟\nأي صفحة كنت فيها؟\nماذا توقعت بدلاً من ذلك؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কী ঘটেছিল?\nআপনি কোন পৃষ্ঠায় ছিলেন?\nআপনি পরিবর্তে কী প্রত্যাশা করেছিলেন?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چه اتفاقی افتاد؟\nدر کدام صفحه بودید؟\nبه جای آن چه انتظار داشتید؟"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que s'est-il passé ?\nSur quelle page étiez-vous ?\nQu'attendiez-vous à la place ?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang terjadi?\nDi halaman mana Anda berada?\nApa yang Anda harapkan?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang berlaku?\nHalaman mana anda berada?\nApa yang anda harapkan sebaliknya?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne oldu?\nHangi sayfadaydınız?\nBunun yerine ne bekliyordunuz?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا ہوا؟\nآپ کس صفحے پر تھے؟\nآپ کو اس کے بجائے کیا توقع تھی؟"
          }
        }
      }
    },
    "What's included in JSON export:": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما المضمن في تصدير JSON:"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "JSON রপ্তানিতে কী অন্তর্ভুক্ত:"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
