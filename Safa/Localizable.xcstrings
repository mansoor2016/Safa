          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাকাত হিসাব করার জন্য আপনার সম্পদ এবং দায় প্রবেশ করুন"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
