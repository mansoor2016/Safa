    "...": {},
    "\"%@\"": {},
    "\"I intend to fast tomorrow for the month of Ramadan\"": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"نويت صوم غد من شهر رمضان\""
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "\"আগামীকাল রমজান মাসের জন্য রোজা রাখার নিয়ত করছি\""
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "«نیت دارم فردا برای ماه رمضان روزه بگیرم»"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« J'ai l'intention de jeûner demain pour le mois de Ramadan »"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Aku niat berpuasa esok hari untuk bulan Ramadan\""
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Saya berniat berpuasa esok untuk bulan Ramadan\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Yarın Ramazan ayı için oruç tutmaya niyet ediyorum\""
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "\"میں نے رمضان کے مہینے میں کل روزہ رکھنے کی نیت کی\""
          }
        }
      }
    },
