    "Deleting a category only removes that data. Your app settings and preferences are not affected.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف فئة يزيل تلك البيانات فقط. إعدادات التطبيق وتفضيلاتك لن تتأثر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি বিভাগ মুছলে শুধুমাত্র সেই ডেটা সরানো হয়। আপনার অ্যাপ সেটিংস এবং পছন্দগুলি প্রভাবিত হয় না।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حذف یک دسته‌بندی فقط آن داده را حذف می‌کند. تنظیمات و ترجیحات برنامه شما تحت تأثیر قرار نمی‌گیرند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer une catégorie ne supprime que ces données. Vos réglages et préférences d'application ne sont pas affectés."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus kategori hanya menghapus data tersebut. Pengaturan dan preferensi aplikasi Anda tidak terpengaruh."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Memadam kategori hanya membuang data tersebut. Tetapan dan keutamaan aplikasi anda tidak terjejas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kategoriyi silmek yalnızca o veriyi kaldırır. Uygulama ayarlarınız ve tercihleriniz etkilenmez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
