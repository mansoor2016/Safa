    "Location access is restricted on this device. Safa will use a default location for prayer times.": {},
    "Location Permission Denied": {},
    "Location permission was denied. Please enable in Settings.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم رفض إذن الموقع. يرجى التفعيل في الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অবস্থান অনুমতি অস্বীকার করা হয়েছে। সেটিংসে সক্ষম করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مجوز موقعیت رد شد. لطفاً در تنظیمات فعال کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation de localisation a été refusée. Veuillez activer dans les Réglages."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin lokasi ditolak. Harap aktifkan di Pengaturan."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebenaran lokasi dinafikan. Sila aktifkan dalam Tetapan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum izni reddedildi. Lütfen Ayarlar'dan etkinleştirin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقام کی اجازت مسترد کر دی گئی۔ براہ کرم ترتیبات میں فعال کریں۔"
          }
        }
      }
    },
