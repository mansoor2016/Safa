    "Could not find or create calendar.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر العثور على التقويم أو إنشاؤه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ক্যালেন্ডার খুঁজে পাওয়া বা তৈরি করা যায়নি।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تقویم یافت یا ساخته نشد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver ou créer le calendrier."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menemukan atau membuat kalender."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mencari atau mencipta kalendar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takvim bulunamadı veya oluşturulamadı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیلنڈر نہیں مل سکا یا بنایا نہیں جا سکا۔"
          }
        }
      }
    },
    "Could not log prayer. Please try again in the app.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر تسجيل الصلاة. يرجى المحاولة مرة أخرى في التطبيق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নামাজ লগ করা যায়নি। অ্যাপে আবার চেষ্টা করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز ثبت نشد. لطفاً دوباره در برنامه امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer la prière. Veuillez réessayer dans l'application."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mencatat shalat. Harap coba lagi di aplikasi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat merekod solat. Sila cuba lagi dalam aplikasi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Namaz kaydedilemedi. Lütfen uygulamada tekrar deneyin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نماز لاگ نہیں ہو سکی۔ براہ کرم ایپ میں دوبارہ کوشش کریں۔"
          }
        }
      }
    },
