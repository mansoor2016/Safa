    "May Allah accept from us and from you.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقبل الله منا ومنكم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আল্লাহ আমাদের এবং আপনাদের থেকে কবুল করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "الله از ما و از شما بپذیرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu'Allah accepte de nous et de vous."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga Allah menerima dari kami dan dari Anda."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga Allah menerima dari kami dan dari kamu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Allah bizden ve sizden kabul etsin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اللہ ہم سے اور آپ سے قبول کرے۔"
          }
        }
      }
    },
    "May Allah accept your Zakat": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقبل الله زكاتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আল্লাহ আপনার যাকাত কবুল করুন"
          }
        },
        "fa": {
          "stringUnit": {
