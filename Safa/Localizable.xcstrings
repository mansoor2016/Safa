    "5. Choose which Safa notification types to allow": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "5. اختر أنواع إشعارات Safa المسموح بها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৫. কোন Safa বিজ্ঞপ্তি প্রকার অনুমতি দিতে হবে তা চয়ন করুন"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۵. انتخاب کنید کدام انواع اعلان‌های Safa مجاز باشند"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Choisissez les types de notifications Safa à autoriser"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Pilih jenis notifikasi Safa yang diizinkan"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Pilih jenis pemberitahuan Safa yang dibenarkan"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5. Hangi Safa bildirim türlerine izin verileceğini seçin"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "5. منتخب کریں کہ Safa کی کون سی اطلاعات کی اقسام کی اجازت دیں"
          }
        }
      }
    },
    "6. Optional: Schedule the Focus for prayer times": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "6. اختياري: جدولة التركيز لأوقات الصلاة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৬. ঐচ্ছিক: নামাজের সময়ের জন্য ফোকাস নির্ধারণ করুন"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۶. اختیاری: تمرکز را برای اوقات نماز زمان‌بندی کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Optionnel : Programmez la concentration aux horaires de prière"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Opsional: Jadwalkan Fokus untuk waktu shalat"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "6. Pilihan: Jadualkan Fokus untuk waktu solat"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "6. İsteğe bağlı: Namaz vakitleri için Odaklanma'yı programlayın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "6. اختیاری: نماز کے اوقات کے لیے Focus شیڈول کریں"
          }
