    "Arabic, Tajweed, and Islamic studies lessons are coming soon.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دروس العربية والتجويد والدراسات الإسلامية قادمة قريبًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরবি, তাজউইদ এবং ইসলামী অধ্যয়নের পাঠ শীঘ্রই আসছে।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درس‌های عربی، تجوید و مطالعات اسلامی به زودی می‌آیند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les leçons d'arabe, de Tajweed et d'études islamiques arrivent bientôt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelajaran bahasa Arab, Tajwid, dan kajian Islam akan segera hadir."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelajaran Arab, Tajwid, dan kajian Islam akan datang tidak lama lagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arapça, Tecvid ve İslami ilimler dersleri yakında geliyor."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عربی، تجوید اور اسلامی علوم کے اسباق جلد آ رہے ہیں۔"
          }
        }
      }
    },
