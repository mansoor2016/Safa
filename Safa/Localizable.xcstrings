            "state": "translated",
            "value": "زکوٰۃ کیلکولیٹر"
          }
        }
      }
    },
    "Zakat Due (2.5%)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزكاة المستحقة (2.5%%)"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাকাত প্রদেয় (২.৫%%)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakat Due (2.5%%)"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زکات واجب (۲.۵%%)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakat due (2,5 %%)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakat yang Harus Dibayar (2,5%%)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakat Wajib (2.5%%)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödenecek Zekat (%%2,5)"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زکوٰۃ واجب (2.5%%)"
          }
        }
      }
    },
    "Zakat is obligatory on every adult Muslim who possesses wealth above the Nisab threshold for a full lunar year (Hawl).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزكاة واجبة على كل مسلم بالغ يملك مالاً فوق نصاب الزكاة لسنة قمرية كاملة (حول)."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি প্রাপ্তবয়স্ক মুসলিমের উপর যাকাত বাধ্যতামূলক যারা পূর্ণ চান্দ্র বছর (হাওল) জুড়ে নিসাব সীমার উপরে সম্পদ রাখেন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زکات بر هر مسلمان بالغی که ثروتی بالاتر از آستانه نصاب برای یک سال قمری کامل (حول) دارد، واجب است."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Zakat est obligatoire pour tout musulman adulte qui possède une richesse au-dessus du seuil Nisab pendant une année lunaire complète (Hawl)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakat wajib bagi setiap Muslim dewasa yang memiliki harta di atas ambang Nisab selama satu tahun Hijriah penuh (Haul)."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakat adalah wajib ke atas setiap Muslim dewasa yang memiliki kekayaan melebihi nisab untuk setahun penuh (Haul)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zekat, bir tam kamerî yıl (Havl) boyunca Nisap eşiğinin üzerinde servete sahip olan her yetişkin Müslümana farzdır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زکوٰۃ ہر بالغ مسلمان پر فرض ہے جو مکمل قمری سال (حول) کے لیے نصاب کی حد سے زیادہ دولت رکھتا ہے۔"
          }
        }
      }
    },
    "Zakat is one of the Five Pillars of Islam. It is a mandatory charitable contribution, typically 2.5% of a Muslim's total savings and wealth above a minimum amount known as Nisab.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الزكاة أحد أركان الإسلام الخمسة. هي مساهمة خيرية إلزامية، عادةً 2.5%% من إجمالي مدخرات المسلم وثروته فوق حد أدنى يُعرف بالنصاب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যাকাত ইসলামের পাঁচটি স্তম্ভের একটি। এটি একটি বাধ্যতামূলক দাতব্য অবদান, সাধারণত একজন মুসলিমের মোট সঞ্চয় এবং সম্পদের ২.৫%% যা নিসাব নামে পরিচিত সর্বনিম্ন পরিমাণের উপরে।"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakat is one of the Five Pillars of Islam. It is a mandatory charitable contribution, typically 2.5%% of a Muslim's total savings and wealth above a minimum amount known as Nisab."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "زکات یکی از پنج رکن اسلام است. یک کمک خیریه اجباری است، معمولاً ۲.۵%% از کل پس‌انداز و ثروت یک مسلمان بالاتر از حداقل مقدار معروف به نصاب."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Zakat est l'un des cinq piliers de l'Islam. C'est une contribution charitable obligatoire, généralement 2,5 % de l'épargne totale et de la richesse d'un musulman au-dessus d'un montant minimum connu sous le nom de Nisab."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakat adalah salah satu dari Lima Rukun Islam. Ini adalah kontribusi amal wajib, biasanya 2,5%% dari total tabungan dan harta seorang Muslim di atas jumlah minimum yang dikenal sebagai Nisab."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakat adalah salah satu daripada Rukun Islam. Ia adalah sumbangan amal wajib, biasanya 2.5%% daripada jumlah simpanan dan kekayaan Muslim melebihi jumlah minimum yang dikenali sebagai Nisab."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zekat İslam'ın Beş Şartından biridir. Bir Müslümanın toplam tasarruf ve servetinin, Nisap olarak bilinen minimum miktarın üzerindeki kısmının genellikle 2,5%%'i olan zorunlu bir hayırsever katkıdır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زکوٰۃ اسلام کے پانچ ستونوں میں سے ایک ہے۔ یہ ایک لازمی خیراتی شراکت ہے، عام طور پر ایک مسلمان کی کل بچت اور دولت کا 2.5%% جو نصاب کے نام سے جانی جانے والی کم از کم رقم سے زیادہ ہو۔"
          }
        }
      }
    },
