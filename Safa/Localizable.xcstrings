    "Prepare to break your fast. May Allah accept your worship.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعد لإفطارك. تقبل الله عبادتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার রোজা ভাঙার জন্য প্রস্তুত হন। আল্লাহ আপনার ইবাদত কবুল করুন।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای افطار آماده شوید. الله عبادت شما را بپذیرد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préparez-vous à rompre le jeûne. Qu'Allah accepte votre adoration."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersiap untuk berbuka puasa. Semoga Allah menerima ibadahmu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bersiap untuk berbuka puasa. Semoga Allah menerima ibadah anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orucunu açmaya hazırlan. Allah ibadetin kabul etsin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا روزہ افطار کرنے کی تیاری کریں۔ اللہ آپ کی عبادت قبول فرمائے۔"
          }
        }
      }
    },
