            "state": "translated",
            "value": "اللہ آپ کی زکوٰۃ قبول فرمائے"
          }
        }
      }
    },
    "May this month bring you peace, mercy, and forgiveness.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسأل الله أن يجلب لك هذا الشهر السلام والرحمة والمغفرة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই মাস আপনার জন্য শান্তি, করুণা এবং ক্ষমা নিয়ে আসুক।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این ماه آرامش، رحمت و بخشش را برای شما به ارمغان بیاورد."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que ce mois vous apporte paix, miséricorde et pardon."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga bulan ini membawa kedamaian, rahmat, dan ampunan bagimu."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga bulan ini membawa kedamaian, rahmat, dan keampunan untuk anda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ay size huzur, merhamet ve bağışlanma getirsin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ مہینہ آپ کے لیے سکون، رحمت اور مغفرت لائے۔"
          }
        }
      }
    },
    "May your journey with Safa be blessed": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بارك الله في رحلتك مع Safa"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Safa এর সাথে আপনার যাত্রা আশীর্বাদপূর্ণ হোক"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سفر شما با Safa مبارک باد"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que votre voyage avec Safa soit béni"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga perjalanan Anda dengan Safa diberkahi"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semoga perjalanan anda dengan Safa diberkati"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Safa ile yolculuğun mübarek olsun"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Safa کے ساتھ آپ کا سفر مبارک ہو"
          }
        }
      }
    },
