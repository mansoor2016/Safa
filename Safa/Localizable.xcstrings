        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سه بار روی شماره نسخه ضربه بزنید برای پنهان کردن."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toucher trois fois le numéro de version pour masquer."
