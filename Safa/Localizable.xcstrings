    "•": {},
    "• Double-tap and hold on the tasbeeh button for rapid counting": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• انقر نقرًا مزدوجًا مع الاستمرار على زر التسبيح للعد السريع"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "• দ্রুত গণনার জন্য তাসবীহ বোতামে ডাবল-ট্যাপ করুন এবং ধরে রাখুন"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "• دوبار ضربه بزنید و دکمه تسبیح را نگه دارید برای شمارش سریع"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Double-tapez et maintenez le bouton tasbih pour un comptage rapide"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "• Ketuk dua kali dan tahan tombol tasbeeh untuk menghitung cepat"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "• Ketuk dua kali dan tahan pada butang tasbih untuk mengira pantas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Hızlı sayım için tesbih düğmesine çift dokunun ve basılı tutun"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "• تیز گنتی کے لیے تسبیح بٹن پر ڈبل ٹیپ کریں اور دبائے رکھیں"
          }
        }
      }
    },
    "• Enable \"Speak Screen\" to have the Quran read aloud": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "• فعّل \"نطق الشاشة\" لقراءة القرآن بصوت عالٍ"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "• কুরআন উচ্চস্বরে পড়ার জন্য \"স্পিক স্ক্রিন\" সক্ষম করুন"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "• «خواندن صفحه» را فعال کنید تا قرآن با صدای بلند خوانده شود"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Activez « Énoncer l'écran » pour faire lire le Coran à voix haute"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "• Aktifkan \"Ucapkan Layar\" untuk membacakan Al-Quran dengan suara"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "• Aktifkan \"Speak Screen\" untuk mendengar bacaan Al-Quran"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Kur'an'ın sesli okunması için \"Ekranı Konuş\"u etkinleştirin"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "• قرآن بلند آواز میں پڑھنے کے لیے \"Speak Screen\" فعال کریں"
          }
        }
      }
