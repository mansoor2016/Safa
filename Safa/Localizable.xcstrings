          "stringUnit": {
            "state": "translated",
            "value": "۳. یک تمرکز جدید ایجاد کنید یا موجود را ویرایش کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Créez une nouvelle concentration ou modifiez-en une existante"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Buat Fokus baru atau edit yang sudah ada"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Cipta Fokus baharu atau edit yang sedia ada"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "3. Yeni bir Odaklanma oluşturun veya mevcut birini düzenleyin"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "3. نیا Focus بنائیں یا موجودہ میں ترمیم کریں"
          }
        }
      }
    },
    "4. Under 'Allowed Notifications', add Safa": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "4. تحت 'الإشعارات المسموح بها'، أضف Safa"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "৪. 'অনুমোদিত বিজ্ঞপ্তি'-র অধীনে, Safa যুক্ত করুন"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۴. در «اعلان‌های مجاز»، Safa را اضافه کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Sous « Notifications autorisées », ajoutez Safa"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Di bawah 'Notifikasi Diizinkan', tambahkan Safa"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "4. Di bawah 'Pemberitahuan Dibenarkan', tambah Safa"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 'İzin Verilen Bildirimler' altında Safa'yı ekleyin"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "4. 'اجازت یافتہ اطلاعات' کے تحت Safa شامل کریں"
