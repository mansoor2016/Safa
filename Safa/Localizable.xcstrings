    "VoiceOver announces the direction to turn and tells you when you're facing the Qibla.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُعلن VoiceOver عن اتجاه الدوران ويخبرك عندما تواجه القبلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver ঘুরার দিক ঘোষণা করে এবং কখন আপনি কিবলার দিকে মুখ করছেন তা বলে দেয়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver جهت چرخش را اعلام می‌کند و به شما می‌گوید کی رو به قبله هستید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver annonce la direction à prendre et vous dit quand vous êtes face à la Qibla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver mengumumkan arah untuk berputar dan memberi tahu Anda saat menghadap Kiblat."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver mengumumkan arah untuk berpusing dan memberitahu anda apabila anda menghadap kiblat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver dönülecek yönü duyurur ve Kıble'ye baktığınızda size söyler."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "VoiceOver مڑنے کی سمت کا اعلان کرتا ہے اور بتاتا ہے جب آپ قبلہ کی طرف ہیں۔"
          }
        }
      }
    },
    "VoiceOver Support": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دعم VoiceOver"
          }
        },
        "bn": {
