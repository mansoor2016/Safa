            "state": "translated",
            "value": "• Leret tiga jari untuk navigasi antara halaman"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "• Sayfalar arasında gezinmek için üç parmakla kaydırın"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "• صفحات کے درمیان جانے کے لیے تین انگلیوں سے سوائپ کریں"
          }
        }
      }
    },
    "• Use rotor to navigate between headings and buttons": {
      "localizations": {
