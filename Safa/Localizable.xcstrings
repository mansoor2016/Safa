            "value": "İndirmeler için WiFi bağlantısı gerekli"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈاؤن لوڈز کے لیے WiFi کنکشن درکار ہے"
          }
        }
      }
    },
