    "Eid Mubarak! A time for sacrifice, charity, and reflection.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيد مبارك! وقت التضحية والصدقة والتأمل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঈদ মুবারক! ত্যাগ, দাতব্য এবং প্রতিফলনের সময়।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عید مبارک! زمانی برای فداکاری، خیریه و تأمل."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aïd Moubarak ! Un temps pour le sacrifice, la charité et la réflexion."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Idul Mubarak! Waktu untuk pengorbanan, sedekah, dan refleksi."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat Hari Raya! Waktu untuk pengorbanan, sedekah, dan refleksi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayramınız Mübarek Olsun! Kurban, sadaka ve tefekkür zamanı."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عید مبارک! قربانی، صدقہ اور غور و فکر کا وقت۔"
          }
        }
      }
    },
    "Eid Mubarak! Taqabbal Allahu minna wa minkum.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيد مبارك! تقبل الله منا ومنكم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ঈদ মুবারক! তাকাব্বাল আল্লাহু মিন্না ওয়া মিনকুম।"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عید مبارک! تقبل الله منا و منکم."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aïd Moubarak ! Taqabbal Allahu minna wa minkum."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Idul Mubarak! Taqabbal Allahu minna wa minkum."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat Hari Raya! Taqabbal Allahu minna wa minkum."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayramınız Mübarek Olsun! Tekabbelallahu minna ve minküm."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عید مبارک! تقبل اللہ منا و منکم۔"
          }
        }
      }
    },
