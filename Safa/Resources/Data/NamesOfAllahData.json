    {"id": 4, "arabic": "الْقُدُّوسُ", "transliteration": "Al-Quddus", "meaning": "The Most Sacred", "explanation": "The One who is pure from any imperfection."},
    {"id": 5, "arabic": "السَّلاَمُ", "transliteration": "As-Salam", "meaning": "The Source of Peace", "explanation": "The One who is free from every imperfection."},
