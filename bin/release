#!/bin/bash
set -euo pipefail

# Usage:
#   bin/release patch        — auto-bump patch (1.3.1 → 1.3.2), commit, push
#   bin/release minor        — auto-bump minor (1.3.1 → 1.4.0), commit, push
#   bin/release 1.4          — explicit version, commit, push
#
# Build number is derived from git commit count at build time (set by
# the "Set Build Number from Git" build phase and ci_post_clone.sh).
# This script only manages MARKETING_VERSION.

PBXPROJ="Safa.xcodeproj/project.pbxproj"

# --- Read current values ---

CURRENT_VERSION=$(grep -m1 'MARKETING_VERSION' "$PBXPROJ" | sed 's/.*= //;s/;.*//')

# --- Collect release notes since last bump ---

release_notes() {
    local last_bump
    last_bump=$(git log --oneline --grep='^Bump ' --format='%H' -1 2>/dev/null || true)

    local range
    if [[ -n "$last_bump" ]]; then
        range="${last_bump}..HEAD"
    else
        range="HEAD~10..HEAD"
    fi

    # Get non-bump commit subjects, prefix with "- "
    local notes
    notes=$(git log --oneline --format='%s' "$range" \
        | grep -v '^Bump ' \
        | sed 's/^/- /' \
        | head -15)

    echo "$notes"
}

# --- No args: show usage ---

if [[ $# -ne 1 ]]; then
    BUILD_NUMBER=$(git rev-list --count HEAD)
    echo "Usage: bin/release <patch|minor|version>"
    echo ""
    echo "  bin/release patch     Auto-bump patch (1.3.1 → 1.3.2)"
    echo "  bin/release minor     Auto-bump minor (1.3.1 → 1.4.0)"
    echo "  bin/release 1.4       Explicit version"
    echo ""
    echo "Current: $CURRENT_VERSION (build $BUILD_NUMBER from git commit count)"
    echo ""
    echo "Build numbers are automatic — derived from git commit count at build time."
    echo "Just push to main and both local and Xcode Cloud builds get the same number."
    exit 1
fi

ARG="$1"

# --- Resolve version ---

if [[ "$ARG" == "patch" ]]; then
    IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
    PATCH=${PATCH:-0}
    VERSION="$MAJOR.$MINOR.$((PATCH + 1))"
elif [[ "$ARG" == "minor" ]]; then
    IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
    VERSION="$MAJOR.$((MINOR + 1)).0"
elif [[ "$ARG" == "--build" ]]; then
    echo "Build numbers are now automatic (git commit count)."
    echo "Just push to main — no manual bump needed."
    exit 0
else
    VERSION="$ARG"
fi

# --- Validate ---

if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
    echo "Error: version must be semver (e.g. 1.3, 1.3.1)"
    exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Error: working tree is dirty — commit or stash changes first"
    exit 1
fi

if [[ "$CURRENT_VERSION" == "$VERSION" ]]; then
    echo "Error: version is already $VERSION"
    exit 1
fi

# --- Apply ---

BUILD_NUMBER=$(git rev-list --count HEAD)
# After this commit, build number will be BUILD_NUMBER + 1
NEXT_BUILD=$((BUILD_NUMBER + 1))

echo "Bumping $CURRENT_VERSION → $VERSION (next build will be $NEXT_BUILD)"

sed -i '' "s/MARKETING_VERSION = $CURRENT_VERSION;/MARKETING_VERSION = $VERSION;/g" "$PBXPROJ"

NOTES=$(release_notes)
COMMIT_MSG="Bump version to $VERSION"
if [[ -n "$NOTES" ]]; then
    COMMIT_MSG="$COMMIT_MSG

$NOTES"
fi

git add "$PBXPROJ"
git commit -m "$COMMIT_MSG"
git push

echo "Released $VERSION (build $NEXT_BUILD)"
if [[ -n "$NOTES" ]]; then
    echo ""
    echo "Release notes:"
    echo "$NOTES"
fi
