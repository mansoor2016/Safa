#!/bin/bash
set -euo pipefail

# Usage: bin/release 1.4
#   - Updates MARKETING_VERSION in project.pbxproj
#   - Commits the version bump
#   - Creates an annotated git tag v{VERSION}
#   - Pushes commit + tag to origin

PBXPROJ="Safa.xcodeproj/project.pbxproj"

# --- Validate input ---

if [[ $# -ne 1 ]]; then
    current=$(grep -m1 'MARKETING_VERSION' "$PBXPROJ" | sed 's/.*= //;s/;.*//')
    echo "Usage: bin/release <version>"
    echo "Current version: $current"
    exit 1
fi

VERSION="$1"
TAG="v$VERSION"

# Sanity checks
if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
    echo "Error: version must be semver (e.g. 1.3, 1.3.1)"
    exit 1
fi

if git tag -l "$TAG" | grep -q .; then
    echo "Error: tag $TAG already exists"
    exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Error: working tree is dirty — commit or stash changes first"
    exit 1
fi

# --- Read current version ---

CURRENT=$(grep -m1 'MARKETING_VERSION' "$PBXPROJ" | sed 's/.*= //;s/;.*//')

if [[ "$CURRENT" == "$VERSION" ]]; then
    echo "Error: version is already $VERSION"
    exit 1
fi

echo "Bumping $CURRENT → $VERSION"

# --- Update pbxproj ---

sed -i '' "s/MARKETING_VERSION = $CURRENT;/MARKETING_VERSION = $VERSION;/g" "$PBXPROJ"

# --- Commit, tag, push ---

git add "$PBXPROJ"
git commit -m "Bump version to $VERSION"
git tag -a "$TAG" -m "$TAG"
git push
git push origin "$TAG"

echo "Released $TAG"
