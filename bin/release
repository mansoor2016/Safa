#!/bin/bash
set -euo pipefail

# Usage:
#   bin/release patch        — auto-bump patch (1.3.1 → 1.3.2), increment build, commit, push
#   bin/release minor        — auto-bump minor (1.3.1 → 1.4.0), increment build, commit, push
#   bin/release 1.4          — explicit version, increment build, commit, push
#   bin/release --build      — increment build number only (no version/tag change), commit, push
#
# Every push to main shows up in App Store Connect, so every push needs
# a unique MARKETING_VERSION + CURRENT_PROJECT_VERSION combination.

PBXPROJ="Safa.xcodeproj/project.pbxproj"

# --- Read current values ---

CURRENT_VERSION=$(grep -m1 'MARKETING_VERSION' "$PBXPROJ" | sed 's/.*= //;s/;.*//')
CURRENT_BUILD=$(grep -m1 'CURRENT_PROJECT_VERSION' "$PBXPROJ" | sed 's/.*= //;s/;.*//')

# --- Collect release notes since last bump ---

release_notes() {
    local last_bump
    last_bump=$(git log --oneline --grep='^Bump ' --format='%H' -1 2>/dev/null || true)

    local range
    if [[ -n "$last_bump" ]]; then
        range="${last_bump}..HEAD"
    else
        range="HEAD~10..HEAD"
    fi

    # Get non-bump commit subjects, prefix with "- "
    local notes
    notes=$(git log --oneline --format='%s' "$range" \
        | grep -v '^Bump ' \
        | sed 's/^/- /' \
        | head -15)

    echo "$notes"
}

# --- No args: show usage ---

if [[ $# -ne 1 ]]; then
    echo "Usage: bin/release <patch|minor|version|--build>"
    echo ""
    echo "  bin/release patch     Auto-bump patch (1.3.1 → 1.3.2)"
    echo "  bin/release minor     Auto-bump minor (1.3.1 → 1.4.0)"
    echo "  bin/release 1.4       Explicit version"
    echo "  bin/release --build   Increment build number only"
    echo ""
    echo "Current: $CURRENT_VERSION ($CURRENT_BUILD)"
    exit 1
fi

ARG="$1"

# --- Build-only mode ---

if [[ "$ARG" == "--build" ]]; then
    if [[ -n "$(git status --porcelain)" ]]; then
        echo "Error: working tree is dirty — commit or stash changes first"
        exit 1
    fi

    NEW_BUILD=$((CURRENT_BUILD + 1))
    echo "Bumping build $CURRENT_BUILD → $NEW_BUILD"

    sed -i '' "s/CURRENT_PROJECT_VERSION = $CURRENT_BUILD;/CURRENT_PROJECT_VERSION = $NEW_BUILD;/g" "$PBXPROJ"

    NOTES=$(release_notes)
    COMMIT_MSG="Bump build to $NEW_BUILD"
    if [[ -n "$NOTES" ]]; then
        COMMIT_MSG="$COMMIT_MSG

$NOTES"
    fi

    git add "$PBXPROJ"
    git commit -m "$COMMIT_MSG"
    git push

    echo "Pushed $CURRENT_VERSION ($NEW_BUILD)"
    if [[ -n "$NOTES" ]]; then
        echo ""
        echo "Release notes:"
        echo "$NOTES"
    fi
    exit 0
fi

# --- Resolve version ---

if [[ "$ARG" == "patch" ]]; then
    IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
    PATCH=${PATCH:-0}
    VERSION="$MAJOR.$MINOR.$((PATCH + 1))"
elif [[ "$ARG" == "minor" ]]; then
    IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
    VERSION="$MAJOR.$((MINOR + 1)).0"
else
    VERSION="$ARG"
fi

# --- Validate ---

if [[ ! "$VERSION" =~ ^[0-9]+\.[0-9]+(\.[0-9]+)?$ ]]; then
    echo "Error: version must be semver (e.g. 1.3, 1.3.1)"
    exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
    echo "Error: working tree is dirty — commit or stash changes first"
    exit 1
fi

if [[ "$CURRENT_VERSION" == "$VERSION" ]]; then
    echo "Error: version is already $VERSION"
    exit 1
fi

# --- Apply ---

NEW_BUILD=$((CURRENT_BUILD + 1))
echo "Bumping $CURRENT_VERSION ($CURRENT_BUILD) → $VERSION ($NEW_BUILD)"

sed -i '' "s/MARKETING_VERSION = $CURRENT_VERSION;/MARKETING_VERSION = $VERSION;/g" "$PBXPROJ"
sed -i '' "s/CURRENT_PROJECT_VERSION = $CURRENT_BUILD;/CURRENT_PROJECT_VERSION = $NEW_BUILD;/g" "$PBXPROJ"

NOTES=$(release_notes)
COMMIT_MSG="Bump version to $VERSION ($NEW_BUILD)"
if [[ -n "$NOTES" ]]; then
    COMMIT_MSG="$COMMIT_MSG

$NOTES"
fi

git add "$PBXPROJ"
git commit -m "$COMMIT_MSG"
git push

echo "Released $VERSION ($NEW_BUILD)"
if [[ -n "$NOTES" ]]; then
    echo ""
    echo "Release notes:"
    echo "$NOTES"
fi
