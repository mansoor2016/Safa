            "state" : "translated",
            "value" : "Bir dokunuşla zikirinizi sayın"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے ذکر کو تھپتھپا کر گنیں۔"
          }
        }
      }
    },
    "Count your dhikr with a tap. Tracks SubhanAllah, Alhamdulillah, Allahu Akbar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عد الذكر الخاص بك بنقرة واحدة. المسارات سبحان الله، الحمد لله، الله أكبر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি টোকা দিয়ে আপনার যিকির গণনা. সুবহানআল্লাহ, আলহামদুলিল্লাহ, আল্লাহু আকবার ট্র্যাক করে।"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ذکر خود را با یک ضربه بشمار. آهنگ های سبحان الله، الحمدلله، الله اکبر."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comptez votre dhikr d'un simple toucher. Pistes SubhanAllah, Alhamdulillah, Allahu Akbar."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitung dzikir Anda dengan satu ketukan. Trek SubhanAllah, Alhamdulillah, Allahu Akbar."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hitunglah zikirmu dengan satu ketukan. Tracks SubhanAllah, Alhamdulillah, Allahu Akbar."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir dokunuşla zikirinizi sayın. Sübhanallah, Elhamdulillah, Allahu Ekber izleri."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنے ذکر کو تھپتھپا کر گنیں۔ سبحان اللہ، الحمدللہ، اللہ اکبر کو ٹریک کرتا ہے۔"
          }
        }
      }
    },
